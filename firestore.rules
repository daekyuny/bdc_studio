rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read profiles (needed for avatars/names);
    // self can create/update own profile; SM can do anything
    match /users/{uid} {
      allow read: if request.auth != null;
      // Self-create: role must be 'member' (bootstrap super_manager via Firebase Console)
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'member';
      // Self-update: cannot change own role
      allow update: if request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      // Super manager can update any field (including role) and delete
      allow update, delete: if isSuperManager();

      // Private memos: only the owner or SM can read/write
      match /memos/{teamId} {
        allow read, write: if request.auth.uid == uid || isSuperManager();
      }
    }

    // Groups: any authenticated user can read (members need group name); PM can create/update their own; SM can delete
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if isPurePM()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth.uid == resource.data.ownerId;
      allow delete: if isSuperManager();
    }

    // Teams: members/owners can read; PM can create; owner can update/delete; SM can do anything
    match /teams/{teamId} {
      allow read: if request.auth.uid in resource.data.memberIds
                  || resource.data.ownerId == request.auth.uid
                  || isSuperManager();
      allow create: if isPurePM() || isSuperManager();
      allow update, delete: if request.auth.uid == resource.data.ownerId || isSuperManager();
    }

    // AppData: only team members can read/write; SM can delete orphaned data
    match /appdata/{teamId} {
      allow read, write: if teamMember(teamId);
      allow delete: if isSuperManager();
    }

    match /invitations/{id} {
      allow read: if true;
      allow create: if isPurePM();
      allow update: if request.auth != null;
    }

    // Pre-registrations: PM can create/read/cancel for their group; SM can do anything
    // Claiming is done via Cloud Function (Admin SDK) and bypasses these rules
    match /preregistrations/{id} {
      allow read: if (isPurePM() && resource.data.createdBy == request.auth.uid)
                  || isSuperManager();
      allow create: if isPurePM()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      // PM can only cancel their own pre-registrations
      allow update: if isPurePM()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'cancelled';
      allow delete: if isSuperManager();
    }

    // App settings: anyone can read (landing page checks before login); only SM can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperManager();
    }

    match /pm_requests/{id} {
      allow create: if true;
      // read: SM can read all; unauthenticated can read individual docs by ID
      // (the random doc ID acts as a bearer token for the approval email link)
      allow read: if true;
      allow update: if isSuperManager();
    }

    function isSuperManager() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_manager';
    }

    function isPurePM() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'product_manager';
    }

    function teamMember(teamId) {
      return request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          || isSuperManager();
    }
  }
}
